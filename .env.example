# Copy to .env and fill in. .env is git-ignored.

# Claude API key (https://console.anthropic.com). Leave empty to run the offline rule-based backend.
ANTHROPIC_API_KEY=

# auto = Claude when a key is set, otherwise rules. Force with "anthropic" or "rules".
LLM_BACKEND=auto
LLM_MODEL=claude-sonnet-5-5
LLM_EFFORT=low
# Server-side refusal fallback (beta). Set to 0 if the API rejects it.
LLM_FALLBACKS=1

# Optional: require ?code=... in the demo URL (recommended for a public deployment).
DEMO_ACCESS_CODE=
